# Frontend environment variables (pre-populated in Bolt projects)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend secret — set in Supabase dashboard under Edge Functions secrets
# DO NOT put this in a VITE_ variable — it would be exposed to the browser
# SERP_API_KEY=your_serpapi_key
